{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.student.v1",
  "title": "Student session record (under 18): standalone, nothing links it to a person or another record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "session.student.v1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "duration_min": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "agent": {
      "enum": [
        "claude-code",
        "codex",
        "cursor",
        "other"
      ]
    },
    "explain_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "subject": {
      "$ref": "#/$defs/slug"
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "level": {
      "enum": [
        "primary",
        "middle",
        "secondary",
        "college",
        "postgraduate",
        "professional",
        "self-learner"
      ]
    },
    "age_band": {
      "enum": [
        "under-13",
        "13-17"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "module": {
            "$ref": "#/$defs/slug"
          },
          "step_ref": {
            "$ref": "#/$defs/slug"
          },
          "type": {
            "enum": [
              "learn",
              "choice",
              "fill",
              "order",
              "practice",
              "explain",
              "quiz",
              "free"
            ]
          },
          "outcome": {
            "enum": [
              "correct",
              "incorrect",
              "skipped",
              "viewed"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "hints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "time_band": {
            "enum": [
              "<30s",
              "30s-2m",
              "2-5m",
              "5-15m",
              ">15m"
            ]
          }
        },
        "required": [
          "module",
          "step_ref",
          "type",
          "outcome",
          "attempts",
          "hints"
        ]
      },
      "maxItems": 500
    },
    "teaching_moves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "$ref": "#/$defs/slug"
          },
          "move": {
            "enum": [
              "explanation",
              "analogy",
              "example",
              "worked-example",
              "visual",
              "re-explain",
              "question"
            ]
          },
          "style": {
            "enum": [
              "hands-on",
              "step-by-step",
              "examples",
              "analogies",
              "visual",
              "theory-first",
              "practice-questions",
              "discussion"
            ]
          },
          "worked": {
            "enum": [
              true,
              false,
              "unknown"
            ]
          }
        },
        "required": [
          "topic",
          "move",
          "worked"
        ]
      },
      "maxItems": 200
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "confused",
              "confident",
              "bored",
              "frustrated",
              "asked-slower",
              "asked-faster",
              "took-break"
            ]
          },
          "topic": {
            "$ref": "#/$defs/slug"
          }
        },
        "required": [
          "kind",
          "topic"
        ]
      },
      "maxItems": 200
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "$ref": "#/$defs/slug"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "ref",
          "passed"
        ]
      },
      "maxItems": 100
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "rating"
      ]
    }
  },
  "required": [
    "schema",
    "date",
    "duration_min",
    "agent",
    "explain_language",
    "subject",
    "topics",
    "level",
    "age_band",
    "steps",
    "teaching_moves",
    "signals",
    "exercises"
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    }
  }
}
