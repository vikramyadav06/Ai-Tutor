{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subject.v1",
  "title": "A subject's chapter list, from a learner's own textbook. Nothing about the learner.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "subject.v1"
    },
    "subject": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "level": {
      "enum": [
        "primary",
        "middle",
        "secondary",
        "college",
        "postgraduate",
        "professional",
        "self-learner"
      ]
    },
    "explain_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "board": {
      "enum": [
        "cbse",
        "cisce",
        "nios",
        "ib",
        "cambridge",
        "state-board",
        "university",
        "other"
      ]
    },
    "textbook": {
      "type": "string",
      "maxLength": 120
    },
    "edition": {
      "type": "string",
      "maxLength": 40
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "kind": {
            "enum": [
              "core",
              "focus",
              "optional"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "kind"
        ]
      }
    },
    "status": {
      "const": "unreviewed"
    }
  },
  "required": [
    "schema",
    "subject",
    "title",
    "level",
    "explain_language",
    "chapters",
    "status"
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    }
  }
}
