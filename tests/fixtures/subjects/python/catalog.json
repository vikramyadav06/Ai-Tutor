      {"value": "career", "label": "Start a programming career"}]}
  ],
  "modules": [
    {"id": "first-steps", "title": "First steps: running Python", "hours": 1, "kind": "core", "requires": []},
    {"id": "values-and-variables", "title": "Values and variables", "hours": 2, "kind": "core", "requires": ["first-steps"]},
    {"id": "control-flow", "title": "Decisions and loops", "hours": 3, "kind": "core", "requires": ["values-and-variables"]},
    {"id": "functions", "title": "Functions", "hours": 3, "kind": "core", "requires": ["control-flow"]},
    {"id": "collections", "title": "Lists, dictionaries and sets", "hours": 3, "kind": "core", "requires": ["functions"]},
    {"id": "files", "title": "Reading and writing files", "hours": 2, "kind": "optional", "requires": ["collections"]},
    {"id": "data-basics", "title": "Working with CSV data", "hours": 3, "kind": "optional", "requires": ["files"]},
    {"id": "testing", "title": "Testing with pytest", "hours": 2, "kind": "optional", "requires": ["functions"]},
