  ],
  "focus_areas": {},
  "rules": [
    {"when": {"goal": "automation"}, "add_modules": ["files"], "reason": "For your goal"},
    {"when": {"goal": "data"}, "add_modules": ["data-basics"], "reason": "For your goal"},
    {"when": {"goal": "career"}, "add_modules": ["testing", "project"], "reason": "For your goal"},
